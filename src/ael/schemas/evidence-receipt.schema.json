{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kizz:ael:schema:evidence-receipt:0.1",
  "title": "Agentic Evidence Lab Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "receipt_id",
    "generated_at",
    "concept_ref",
    "study_ref",
    "run_record_refs",
    "measurement_set_ref",
    "evidence_level",
    "reproducibility",
    "independence",
    "decision",
    "evaluated_claims",
    "unsupported_inferences",
    "limitations",
    "invalidation_triggers",
    "state",
    "publication_state",
    "generator"
  ],
  "properties": {
    "schema_version": {"const": "ael.evidence-receipt/0.1"},
    "object_type": {"const": "evidence_receipt"},
    "receipt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "concept_ref": {
      "allOf": [
        {"$ref": "#/$defs/artifact_ref"},
        {
          "type": "object",
          "required": ["concept_id", "revision"],
          "properties": {
            "concept_id": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "study_ref": {
      "allOf": [
        {"$ref": "#/$defs/artifact_ref"},
        {
          "type": "object",
          "required": ["study_id", "revision"],
          "properties": {
            "study_id": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "run_record_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/artifact_ref"},
          {
            "type": "object",
            "required": ["run_id"],
            "properties": {"run_id": {"type": "string", "minLength": 1}}
          }
        ]
      }
    },
    "measurement_set_ref": {
      "allOf": [
        {"$ref": "#/$defs/artifact_ref"},
        {
          "type": "object",
          "required": ["measurement_set_id"],
          "properties": {"measurement_set_id": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "evidence_level": {"enum": ["structurally_valid", "runtime_conformant", "controlled_effect_observed", "effect_reproduced", "downstream_outcome_observed", "transferred", "externally_decision_changing", "paid_repeated_use", "independently_outcome_verified"]},
    "reproducibility": {"enum": ["not_rerunnable", "rerunnable", "replayable", "statistically_reproduced", "transferred", "independently_verified"]},
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "role_overlaps", "disclosure"],
      "properties": {
        "label": {"enum": ["self_review", "model_critique", "maintainer_evaluated", "reproduced_third_party", "independently_verified"]},
        "role_overlaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "disclosure": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "summary", "scope", "reversal_trigger"],
      "properties": {
        "disposition": {"enum": ["adopt", "reject", "narrow", "inconclusive"]},
        "summary": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reversal_trigger": {"type": "string", "minLength": 1}
      }
    },
    "evaluated_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "status", "claim_level", "scope", "evidence_refs", "falsifier"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "contradicted", "bounded", "unresolved"]},
          "claim_level": {"enum": ["artifact", "workflow", "factor_causal", "operational_stack", "model_only", "transfer", "outcome"]},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "falsifier": {"type": "string", "minLength": 1}
        }
      }
    },
    "unsupported_inferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invalidation_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "artifact", "repository", "publication", "deployment", "outcome"],
      "properties": {
        "experiment": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "publication": {"type": "string", "minLength": 1},
        "deployment": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1}
      }
    },
    "publication_state": {"enum": ["private", "public_ready", "published", "embargoed"]},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": ["uri", "sha256", "visibility"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "format": "uri-reference"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 1}]},
        "visibility": {"enum": ["public", "private", "hidden", "embargoed"]}
      }
    }
  }
}
