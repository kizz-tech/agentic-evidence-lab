{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kizz:ael:schema:run-record:0.1",
  "title": "Agentic Evidence Lab Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "run_id",
    "study_ref",
    "condition_id",
    "task",
    "repeat_index",
    "status",
    "runtime",
    "usage",
    "outputs",
    "effects",
    "event_summary",
    "integrity_issues",
    "source_refs"
  ],
  "properties": {
    "schema_version": {"const": "ael.run-record/0.1"},
    "object_type": {"const": "run_record"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"},
    "study_ref": {
      "allOf": [
        {"$ref": "#/$defs/artifact_ref"},
        {
          "type": "object",
          "required": ["study_id", "revision"],
          "properties": {
            "study_id": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "condition_id": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_pack_id", "task_id", "stratum", "role"],
      "properties": {
        "task_pack_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "stratum": {"type": "string", "minLength": 1},
        "role": {"enum": ["calibration", "adaptation", "screening", "holdout", "real_shadow", "negative_control", "transfer"]}
      }
    },
    "repeat_index": {"type": "integer", "minimum": 1},
    "status": {"enum": ["valid", "invalid", "failed", "unrun"]},
    "invalid_reason": {"type": "string", "minLength": 1},
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry_of", "reason", "byte_equivalent"],
      "properties": {
        "retry_of": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "byte_equivalent": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "model", "sandbox", "environment"],
      "properties": {
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model_id", "effort", "immutable_revision_exposed"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model_id": {"type": "string", "minLength": 1},
            "effort": {"type": "string", "minLength": 1},
            "immutable_revision_exposed": {"type": "boolean"}
          }
        },
        "sandbox": {"type": "string", "minLength": 1},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ephemeral", "identity_available"],
          "properties": {
            "ephemeral": {"type": "boolean"},
            "identity_available": {"type": "boolean"},
            "digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "tool_policy_sha256": {"$ref": "#/$defs/sha256"},
        "context_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "wall_time_ms"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "reported_cost": {"type": "number", "minimum": 0},
        "cost_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect_type", "target", "outcome", "evidence_refs"],
        "properties": {
          "effect_type": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["observed", "not_observed", "unknown"]},
          "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}}
        }
      }
    },
    "event_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured", "event_count", "authenticated_actor_ids"],
      "properties": {
        "captured": {"type": "boolean"},
        "event_count": {"type": "integer", "minimum": 0},
        "authenticated_actor_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "integrity_issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "invalid"}}, "required": ["status"]},
      "then": {"required": ["invalid_reason"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": ["uri", "visibility"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "format": "uri-reference"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 1}]},
        "visibility": {"enum": ["public", "private", "hidden", "embargoed"]}
      }
    }
  }
}
