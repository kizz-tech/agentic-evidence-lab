{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "progress", "ledger"],
  "properties": {
    "verdict": {
      "enum": ["complete", "incomplete", "uncertain"]
    },
    "progress": {
      "enum": ["continuable", "awaiting_clarification", "externally_blocked"]
    },
    "ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "state", "evidence_refs"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
          },
          "state": {
            "enum": ["verified", "failed", "unresolved"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
